{
	"name": "dtf_calificaciones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "calificaciones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as string,",
				"          puntuacion as string,",
				"          comentario as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(comentario = initCap(lower(trim(comentario)))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(puntuacion) && !isNull(fecha_calificacion) && !isNull(comentario) && comentario!='',",
				"     disjoint: false) ~> split1@(valido, rechazado)",
				"split1@valido aggregate(groupBy(calificacion_id),",
				"     fecha_calificacion = first(fecha_calificacion),",
				"          puntuacion = first(puntuacion),",
				"          comentario = first(comentario)) ~> aggregate1",
				"aggregate1 derive(fecha_calificacion = toDate(fecha_calificacion, 'yyyy-MM-dd'),",
				"          puntuacion = toInteger(puntuacion)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}